# Backend — copy to .env in the backend folder

PORT=5000

# Neon — Connection string (Dashboard → Connect → copy)
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT secret for auth tokens (change in production)
JWT_SECRET=your-secret-key-here

# Stripe secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here

# Frontend URL (used for CORS and Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173